;;Header
; This is sent once each time the scoreboard is updated with results. It
; is sent before any result lines are sent.
; Line codes:
;  \00 No Variable
;  \01 Event name
;  \02 Event number
;  \03 Round number
;  \04 Heat number
;  \05 Wind
;  \06 TimeRunning

; The following line (if not commented) will tell PFP Broadcast SB to change layouts.
; Header
\13\0d12345\I2
\13\01%s\03
\13\02%s\03
\13\03%s\03
\13\04%s\03
\13\05%s\03
\13\06%s\03;;;;

;;Result
; This is sent once for each result line displayed on the scoreboard.
; Line codes:
;  \00 No variable
;  \01 Name
;  \02 Affiliation
;  \03 Place
;  \04 Time
;  \05 Lane
;  \06 Id

; The following line (if not commented) will tell PFP Broadcast SB to change layouts.
; Result
\14\01%s\03
\14\02%s\03
\14\03%s\03
\14\04%s\03
\14\05%s\03
\14\06%s\03;;;